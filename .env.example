# Copy to .env and fill in your own values.
# Required credentials
DISCORD_TOKEN=
OPENAI_API_KEY=

# Common options (safe defaults are provided for most settings)
COMMAND_PREFIX=!
ELBOT_USERNAME=Elbot
# Experimental one-bot voice receive bridge. Keep lavalink until bridge acceptance passes.
ELBOT_VOICE_TRANSPORT=lavalink
# Requires the external_bridge Lavalink fork; stock Lavalink cannot provide this endpoint.
# ELBOT_VOICE_BRIDGE_URL=ws://127.0.0.1:2333/bridge/v1
# ELBOT_VOICE_BRIDGE_TOKEN=
# ELBOT_VOICE_NODE=/path/to/node-v22-or-newer/bin/node
# Local wake phrase (Phase 2): a Vosk model directory, e.g. vosk-model-small-en-us-0.15.
# Unset = speaker detection only. ELBOT_WAKE_PHRASES overrides "elbot,el bot,hey elbot,hey el bot,elbow".
# ELBOT_WAKE_MODEL=/path/to/vosk-model-small-en-us-0.15
# ELBOT_WAKE_ENABLED=1
# GPT-Live (Phase 3, /live start). Uses OPENAI_API_KEY. Voice is billed per connected second.
# ELBOT_LIVE_MODEL=gpt-live-1
# ELBOT_LIVE_BACKEND_MODEL=gpt-5.6-luna
# ELBOT_LIVE_VOICE=marin
# ELBOT_LIVE_PRICE_PER_MIN=0.05
# ELBOT_LIVE_SPEECH_GAIN=3.5   # bot voice level multiplier (0.1-8, saturating)
# ELBOT_LIVE_SESSION_MAX_MIN=10
# ELBOT_LIVE_WARN_MIN=7
# ELBOT_LIVE_IDLE_S=30
# ELBOT_LIVE_DAILY_USD=2
# ELBOT_LIVE_MONTHLY_USD=8
AUTO_LAVALINK=1
LAVALINK_HOST=localhost
LAVALINK_PORT=0  # 0 lets auto-lavalink choose an open port
LAVALINK_PASSWORD=changeme
# Customize the auto-selected Lavalink port range (inclusive).
# AUTO_LAVALINK_PORT_START=2333
# AUTO_LAVALINK_PORT_TRIES=40  # scans start..start+tries-1
# Override the pinned Lavalink 4.2.2 download used by auto_lavalink.py.
# LAVALINK_DOWNLOAD_URL=https://github.com/lavalink-devs/Lavalink/releases/download/4.2.2/Lavalink.jar
# Adjust once Mafic announces support for newer builds. Set
# MAFIC_MAX_SUPPORTED_LAVALINK_VERSION to silence the startup warning.
FFMPEG_PATH=
ELBOT_DATA_DIR=
# Required for panel access. Generate with the password prompt documented in README.
ELBOT_PORTAL_USERNAME=admin
ELBOT_PORTAL_PASSWORD_HASH=
# Local-only by default; use an SSH tunnel or HTTPS proxy for remote access.
ELBOT_PORTAL_HOST=127.0.0.1
# Set to 1 when accessed over HTTPS (secure session cookies).
ELBOT_PORTAL_HTTPS=0
ELBOT_PORTAL_SECRET=

# youtube-source plugin version (auto-lavalink fetches this release)
LAVALINK_YOUTUBE_PLUGIN_VERSION=1.18.2
# Spotify/Apple Music resolver plugin version used by auto-lavalink.
LAVALINK_LAVASRC_PLUGIN_VERSION=4.8.3

# Backend preference: set to 'fallback' to use yt-dlp first, or 'lavalink' to prefer Lavalink
ELBOT_PRIMARY_BACKEND=fallback
# Hedge delay before starting Lavalink when fallback is primary (seconds)
ELBOT_LAVALINK_HEDGE_DELAY=5.0

# YouTube cookies (strongly recommended for reliable playback)
# Option A (browser extension):
#   1. Log into https://youtube.com in a desktop browser.
#   2. Use an extension like "Get cookies.txt LOCALLY" to export cookies.txt.
# Option B (command line on this host):
#   yt-dlp --cookies-from-browser chromium --write-cookies ~/youtube_cookies.txt \
#          https://www.youtube.com/watch?v=dQw4w9WgXcQ
# After exporting, set the path below (absolute path or relative to this repo).
YT_COOKIES_FILE=

# Hedge delay before starting yt-dlp fallback (seconds)
# Lower values start fallback sooner but waste a yt-dlp call when Lavalink succeeds.
ELBOT_FALLBACK_HEDGE_DELAY=1.5
# Keep disabled on small hosts; timed-out yt-dlp autocomplete work cannot be cancelled.
ELBOT_AUTOCOMPLETE_YTDLP=0
# Leave voice after this many idle seconds. Set to 0 to stay connected.
ELBOT_MUSIC_IDLE_TIMEOUT=180
# Refresh the now-playing progress display this often (minimum 5 seconds).
ELBOT_NOW_PLAYING_UPDATE_INTERVAL=15
# Optional public URL shown as a Dashboard button on the music controller.
# ELBOT_MUSIC_DASHBOARD_URL=https://bot.example.com/

# Spotify support (free — get credentials from https://developer.spotify.com/dashboard)
# Enables pasting Spotify track/album/playlist links in /play.
# LavaSrc resolves Spotify metadata and searches YouTube for the audio.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_COUNTRY_CODE=US

# Feature-specific settings (optional)
GUILD_ID=
ICS_URL=
F1_CHANNEL_ID=
LOCAL_TIMEZONE=
ELBOT_SERVICE=elbot.service
PORT=8000
